<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clickable="true"
    android:fillViewport="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Back Button -->
        <LinearLayout
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="8dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Volver"
                android:src="@drawable/arrow_left"
                app:tint="@color/foreground" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/font_sans"
                android:text="Volver"
                android:textColor="@color/foreground"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Container for disconnected state -->
        <LinearLayout
            android:id="@+id/layout_disconnected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card 1: Buscar salas en la red -->
            <LinearLayout
                android:id="@+id/card_scan_rooms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_scan_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/font_outfit"
                    android:text="Buscar salas en la red"
                    android:textColor="@color/foreground"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_scan_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/font_sans"
                    android:text="Encuentra partidas creadas en tu red WiFi local"
                    android:textColor="@color/muted_foreground"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_scan_rooms"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_btn_scan"
                    android:fontFamily="@font/font_sans"
                    android:text="Escanear salas"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_foreground"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Scanning indicator container -->
                <LinearLayout
                    android:id="@+id/layout_scanning_indicator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ProgressBar
                        android:id="@+id/pb_scanning"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/accent" />

                    <TextView
                        android:id="@+id/tv_scanning_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/font_sans"
                        android:text="Escaneando red local..."
                        android:textColor="@color/muted_foreground"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Rooms RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_rooms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_room_row" />

            </LinearLayout>

            <!-- Card 2: Conexión manual -->
            <LinearLayout
                android:id="@+id/card_manual_connect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONEXIÓN MANUAL"
                    android:textAppearance="@style/TextAppearance.TriviaLAN.LabelUpper" />

                <!-- IP Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/font_sans"
                    android:text="Dirección IP del Host"
                    android:textColor="@color/muted_foreground"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_host_ip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false"
                    app:errorEnabled="true"
                    app:errorTextColor="@color/muted_foreground"
                    app:errorIconDrawable="@null">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_host_ip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input"
                        android:fontFamily="monospace"
                        android:hint="192.168.X.X"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:singleLine="true"
                        android:textColor="@color/foreground"
                        android:textColorHint="@color/muted_foreground"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Port Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/font_sans"
                    android:text="Puerto"
                    android:textColor="@color/muted_foreground"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_host_port"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false"
                    app:errorEnabled="true"
                    app:errorTextColor="@color/muted_foreground"
                    app:errorIconDrawable="@null">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_host_port"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input"
                        android:fontFamily="monospace"
                        android:hint="8888"
                        android:inputType="number"
                        android:maxLines="1"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:singleLine="true"
                        android:text="8888"
                        android:textColor="@color/foreground"
                        android:textColorHint="@color/muted_foreground"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_manual_connect"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_btn_start_game"
                    android:fontFamily="@font/font_sans"
                    android:text="Conectar a la Sala"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_foreground"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>

        <!-- Container for connected state -->
        <LinearLayout
            android:id="@+id/layout_connected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Card: Radar icon and status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Pulsing radar container -->
                <FrameLayout
                    android:id="@+id/layout_radar_pulse"
                    android:layout_width="90dp"
                    android:layout_height="90dp">

                    <View
                        android:id="@+id/view_pulse_circle"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_pulse_circle" />

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_qr_box">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:contentDescription="Radar"
                            android:src="@drawable/radar"
                            app:tint="@color/accent" />
                    </FrameLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_connected_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/font_outfit"
                    android:text="¡Conectado al Host!"
                    android:textAlignment="center"
                    android:textColor="@color/foreground"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_connected_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/font_sans"
                    android:text="Esperando que inicie la partida..."
                    android:textAlignment="center"
                    android:textColor="@color/muted_foreground"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Section: JUGADORES EN LA SALA (X) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_connected_players_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/font_sans"
                    android:text="JUGADORES EN LA SALA (1)"
                    android:textAppearance="@style/TextAppearance.TriviaLAN.LabelUpper"
                    tools:text="JUGADORES EN LA SALA (3)" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_live_badge"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/bg_dot_live" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/font_sans"
                        android:text="EN SALA"
                        android:textColor="@color/success"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- RecyclerView of players -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_connected_players"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_player_client_lobby" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
