<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HUD Top Bar -->
        <LinearLayout
            android:id="@+id/layout_hud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Left: Round Counter -->
            <TextView
                android:id="@+id/tv_round_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hud_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textColor="@color/muted_foreground"
                android:textStyle="bold"
                android:textSize="12sp"
                android:fontFamily="@font/font_outfit"
                android:text="Pregunta 1/10"
                tools:text="Pregunta 1/10" />

            <!-- Center: Timer -->
            <LinearLayout
                android:id="@+id/layout_timer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="12dp"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_timer_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15s"
                    android:textColor="@color/success"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/font_outfit"
                    tools:text="15s" />

                <ProgressBar
                    android:id="@+id/pb_timer"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:indeterminate="false"
                    android:max="15000"
                    android:progress="15000"
                    android:background="@drawable/bg_progress_track"
                    android:progressDrawable="@drawable/progress_bar_timer" />
            </LinearLayout>

            <!-- Right: Score -->
            <TextView
                android:id="@+id/tv_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_score_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:textSize="12sp"
                android:fontFamily="@font/font_outfit"
                android:text="0 pts"
                tools:text="0 pts" />
        </LinearLayout>

        <!-- Question Card -->
        <LinearLayout
            android:id="@+id/card_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="16dp"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Category & Difficulty Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_category_pill"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/accent"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:fontFamily="@font/font_sans"
                    android:text="General Knowledge"
                    android:layout_marginEnd="8dp"
                    tools:text="General Knowledge" />

                <TextView
                    android:id="@+id/tv_difficulty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hud_pill"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/muted_foreground"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:fontFamily="@font/font_sans"
                    android:text="Fácil"
                    tools:text="Fácil" />
            </LinearLayout>

            <!-- Question Text -->
            <TextView
                android:id="@+id/tv_question_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAlignment="center"
                android:gravity="center"
                android:textColor="@color/foreground"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="@font/font_outfit"
                android:text="Cargando pregunta..."
                tools:text="¿Cuál es la capital del país más grande del mundo?" />
        </LinearLayout>

        <!-- 4 Options Container -->
        <LinearLayout
            android:id="@+id/layout_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Option 0 (A) -->
            <LinearLayout
                android:id="@+id/btn_option_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginVertical="6dp"
                android:background="@drawable/bg_btn_option_idle"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <TextView
                    android:id="@+id/tv_letter_0"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_letter_badge"
                    android:gravity="center"
                    android:text="A"
                    android:textColor="@color/foreground"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:fontFamily="@font/font_outfit" />

                <TextView
                    android:id="@+id/tv_text_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/foreground"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_sans"
                    tools:text="Primera opción" />
            </LinearLayout>

            <!-- Option 1 (B) -->
            <LinearLayout
                android:id="@+id/btn_option_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginVertical="6dp"
                android:background="@drawable/bg_btn_option_idle"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <TextView
                    android:id="@+id/tv_letter_1"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_letter_badge"
                    android:gravity="center"
                    android:text="B"
                    android:textColor="@color/foreground"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:fontFamily="@font/font_outfit" />

                <TextView
                    android:id="@+id/tv_text_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/foreground"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_sans"
                    tools:text="Segunda opción" />
            </LinearLayout>

            <!-- Option 2 (C) -->
            <LinearLayout
                android:id="@+id/btn_option_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginVertical="6dp"
                android:background="@drawable/bg_btn_option_idle"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <TextView
                    android:id="@+id/tv_letter_2"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_letter_badge"
                    android:gravity="center"
                    android:text="C"
                    android:textColor="@color/foreground"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:fontFamily="@font/font_outfit" />

                <TextView
                    android:id="@+id/tv_text_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/foreground"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_sans"
                    tools:text="Tercera opción" />
            </LinearLayout>

            <!-- Option 3 (D) -->
            <LinearLayout
                android:id="@+id/btn_option_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginVertical="6dp"
                android:background="@drawable/bg_btn_option_idle"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <TextView
                    android:id="@+id/tv_letter_3"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_letter_badge"
                    android:gravity="center"
                    android:text="D"
                    android:textColor="@color/foreground"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:fontFamily="@font/font_outfit" />

                <TextView
                    android:id="@+id/tv_text_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/foreground"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_sans"
                    tools:text="Cuarta opción" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
