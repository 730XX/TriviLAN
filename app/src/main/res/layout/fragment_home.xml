<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="36dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/ll_title_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="8dp" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_subtitle"
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.TriviaLAN.Subtitle" />
        </LinearLayout>

        <!-- Avatar & Name Card -->
        <LinearLayout
            android:id="@+id/card_player"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_avatar_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_avatar_label"
                android:textAppearance="@style/TextAppearance.TriviaLAN.LabelUpper" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_avatars"
                tools:listitem="@layout/item_avatar"
                tools:itemCount="10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <TextView
                android:id="@+id/tv_player_name_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/home_player_name_label"
                android:textAppearance="@style/TextAppearance.TriviaLAN.LabelUpper" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_player_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxBackgroundMode="none"
                app:hintEnabled="false"
                app:errorEnabled="true"
                app:errorTextColor="@color/muted_foreground"
                app:errorIconDrawable="@null">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_player_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:hint="@string/home_player_name_hint"
                    android:inputType="textPersonName"
                    android:maxLength="14"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.TriviaLAN.Body"
                    android:textColor="@color/foreground"
                    android:textColorHint="@color/muted_foreground" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Button 1: Host Room -->
        <LinearLayout
            android:id="@+id/btn_create_room"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/gradient_host"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_crown"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/crown"
                    app:tint="@color/primary_foreground" />

                <TextView
                    android:id="@+id/tv_create_room_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_create_room_title"
                    android:textAppearance="@style/TextAppearance.TriviaLAN.ActionTitleHost" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_create_room_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/home_create_room_desc"
                android:textAppearance="@style/TextAppearance.TriviaLAN.ActionDescHost" />
        </LinearLayout>

        <!-- Button 2: Join Room -->
        <LinearLayout
            android:id="@+id/btn_join_room"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/gradient_join"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_gamepad"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/gamepad_2"
                    android:backgroundTint="@color/black"
                    app:tint="@color/accent_foreground" />

<!--                <ImageView-->
<!--                    android:id="@+id/iv_wifi"-->
<!--                    android:layout_width="22dp"-->
<!--                    android:layout_height="22dp"-->
<!--                    android:layout_marginEnd="12dp"-->
<!--                    android:contentDescription="@null"-->
<!--                    android:src="@drawable/ic_wifi"-->
<!--                    app:tint="@color/accent_foreground" />-->

                <TextView
                    android:id="@+id/tv_join_room_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_join_room_title"
                    android:textAppearance="@style/TextAppearance.TriviaLAN.ActionTitleJoin" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_join_room_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/home_join_room_desc"
                android:textAppearance="@style/TextAppearance.TriviaLAN.ActionDescJoin" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
